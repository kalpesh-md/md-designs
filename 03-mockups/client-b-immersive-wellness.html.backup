<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MoodScale — Client Dashboard · Design B</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../02-tokens/tokens.css">
<style>
  .bento { display: grid; grid-template-columns: 1.2fr 1fr 1fr; grid-template-rows: auto auto; gap: var(--space-5); }
  .span-3 { grid-column: 1 / -1; }
  .span-2 { grid-column: span 2; }

  .hero-match {
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 100%);
    color: #fff; border: none;
  }
  .hero-match .kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: .75; margin-bottom: 8px; }
  .hero-match h2 { font-size: var(--text-xl); font-weight: 700; margin-bottom: 6px; }
  .hero-match p { font-size: var(--text-sm); opacity: .85; max-width: 48ch; margin-bottom: var(--space-5); }
  .hero-match .btn { background: #fff; color: var(--brand); }
  .hero-match .btn:hover { background: var(--accent-soft); }

  .match-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); padding: var(--space-5); }
  .t-card { padding: var(--space-5); background: var(--surface-tint); border: 1px solid var(--border); border-radius: var(--radius-lg); display: flex; flex-direction: column; gap: 10px; }
  .t-card .top { display: flex; align-items: center; gap: 12px; }
  .t-card .avatar { width: 48px; height: 48px; }
  .t-card .name { font-size: var(--text-sm); font-weight: 700; }
  .t-card .spec { font-size: var(--text-xs); color: var(--ink-tertiary); }
  .t-card .reason { font-size: 12px; color: var(--ink-secondary); font-style: italic; line-height: 1.5; flex: 1; }
  .t-card .cta { font-size: var(--text-xs); font-weight: 600; color: var(--brand); }

  .dates { display: flex; gap: 8px; }
  .date-chip { flex: 1; text-align: center; padding: 10px 6px; border: 1px solid var(--border); border-radius: var(--radius-md); }
  .date-chip .d { font-size: 10px; color: var(--ink-tertiary); font-weight: 600; }
  .date-chip .n { font-size: 22px; font-weight: 700; display: block; }
  .date-chip.on { border-color: var(--brand-mid); background: var(--brand-soft); color: var(--brand); }
  .times { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
  .time-chip { padding: 8px 12px; font-size: 12px; font-weight: 600; border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--surface); }

  .assess-row { display: flex; gap: 10px; }
  .assess { flex: 1; text-align: center; padding: 16px 8px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-tint); }
  .assess .tag { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; }
  .assess .abbr { font-size: 22px; font-weight: 700; display: block; margin: 4px 0 2px; }
  .assess .lab { font-size: 10px; color: var(--ink-tertiary); }

  .session-hero { padding: var(--space-5); }
  .session-hero .when { font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.02em; margin: 8px 0 4px; }
  .session-hero .meta-row { display: flex; gap: 8px; margin: 14px 0; flex-wrap: wrap; }
  .card-pad { padding: var(--space-5); }
  .next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); padding: var(--space-5); }
  .next-card { padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-tint); }
  .next-card h3 { font-size: var(--text-sm); font-weight: 700; margin: 10px 0 6px; }
  .next-card p { font-size: var(--text-xs); color: var(--ink-secondary); }
  .next-card .cta { display: inline-block; margin-top: 12px; font-size: var(--text-xs); font-weight: 600; color: var(--brand); }

  @media (max-width: 1100px) {
    .bento, .match-grid, .next-grid { grid-template-columns: 1fr; }
    .span-2, .span-3 { grid-column: auto; }
    .assess-row { flex-direction: column; }
  }
</style>
</head>
<body class="palette-b portal-client">
<header class="topbar">
  <div class="topbar-left">
    <img src="assets/moodscale_logo1.png" alt="MoodScale" class="logo-wordmark-lg">
    <span class="topbar-divider"></span>
    <span class="topbar-title">Dashboard</span>
  </div>
  <div class="topbar-right">
    <span class="credit-chip"><img src="assets/icon-192.png" alt="" width="16" height="16"> 3 session credits</span>
    <button class="icon-btn" aria-label="Notifications">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="notif-dot"></span>
    </button>
    <span class="avatar">KS</span>
  </div>
</header>
<div class="shell">
  <aside class="sidebar">
    <nav class="nav">
      <a href="#" class="active"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Dashboard</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span>Sessions</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><span>Assessments</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Credits</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><span>Packages</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 14v7M7 14v7M17 3v4M7 3v4M12 21V3"/></svg><span>Nature Retreats</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span>Messages</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg><span>Live Support</span></a>
    </nav>
    <div class="sidebar-footer">
      <span class="avatar">KS</span>
      <div class="who"><div class="name">Kalpesh S.</div><div class="meta">3 session credits</div></div>
    </div>
  </aside>

  <main class="main">
    <header class="page-header">
      <h1>Welcome back, Kalpesh</h1>
      <p class="sub">What would you like to do today?</p>
    </header>

    <div class="bento">
      <section class="card hero-match span-3">
        <div style="display:flex;align-items:flex-start;gap:16px">
          <img src="assets/icon-192.png" alt="" width="48" height="48" style="border-radius:50%;background:#fff;padding:4px;flex-shrink:0">
          <div>
            <div class="kicker">AI Therapist Matching</div>
            <h2>Your AI Matches</h2>
            <p>Personalised based on your profile · 1 match remaining this month</p>
            <a class="btn" href="#">Try Another Match</a>
          </div>
        </div>
      </section>

      <section class="card span-3">
        <div class="card-head">
          <div><h2>Matched therapists</h2><div class="meta">Personalised based on your profile</div></div>
        </div>
        <div class="match-grid">
          <div class="t-card">
            <div class="top"><span class="avatar">DR</span><div><div class="name">Dr. Riya Mehta</div><div class="spec">Anxiety · CBT</div></div></div>
            <div><span class="pill pill-info">Video</span> <span class="pill pill-success">Phone</span> <span style="float:right;font-size:12px;font-weight:600">★ 4.9</span></div>
            <p class="reason">“Strong match for sleep anxiety and structured CBT work.”</p>
            <span class="cta">View availability →</span>
          </div>
          <div class="t-card">
            <div class="top"><span class="avatar">AK</span><div><div class="name">Aarav Kapoor</div><div class="spec">Couples · Trauma</div></div></div>
            <div><span class="pill pill-info">Video</span> <span style="float:right;font-size:12px;font-weight:600">★ 4.8</span></div>
            <p class="reason">“Aligned with your preference for a calm, insight-led style.”</p>
            <span class="cta">View availability →</span>
          </div>
          <div class="t-card">
            <div class="top"><span class="avatar">NS</span><div><div class="name">Neha Shah</div><div class="spec">Stress · Mindfulness</div></div></div>
            <div><span class="pill pill-info">Video</span> <span class="pill pill-success">Phone</span> <span style="float:right;font-size:12px;font-weight:600">★ 4.7</span></div>
            <p class="reason">“Good fit if you want short, practical between-session tools.”</p>
            <span class="cta">View availability →</span>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <div><h2>Upcoming Session</h2><div class="meta">Your next scheduled session</div></div>
          <span class="pill pill-success">Upcoming</span>
        </div>
        <div class="session-hero">
          <div class="when">Thu, 20 Aug</div>
          <div style="color:var(--ink-secondary);font-size:14px">10:00 AM · Video · 50 min</div>
          <div class="meta-row">
            <span class="pill pill-brand">Dr. Riya Mehta</span>
            <span class="pill pill-info">Video</span>
          </div>
          <a class="btn btn-secondary" href="#" style="width:100%;justify-content:center">View details</a>
        </div>
      </section>

      <section class="card span-2">
        <div class="card-head">
          <div><h2>Earliest Booking</h2><div class="meta">Available slots for the next 2 weeks</div></div>
          <a class="ghost-link" href="#">View all →</a>
        </div>
        <div class="card-pad">
          <div class="dates">
            <div class="date-chip on"><span class="d">Wed</span><span class="n">19</span></div>
            <div class="date-chip"><span class="d">Thu</span><span class="n">20</span></div>
            <div class="date-chip"><span class="d">Fri</span><span class="n">21</span></div>
            <div class="date-chip"><span class="d">Sat</span><span class="n">22</span></div>
          </div>
          <div class="times">
            <span class="time-chip">10:00 AM</span>
            <span class="time-chip">12:00 PM · 2 therapists</span>
            <span class="time-chip">3:00 PM</span>
            <span class="time-chip">6:00 PM</span>
          </div>
        </div>
      </section>

      <section class="card span-3">
        <div class="card-head">
          <div><h2>Quick Assessment</h2><div class="meta">Check in with how you're feeling</div></div>
          <a class="ghost-link" href="#">View all →</a>
        </div>
        <div class="card-pad">
          <div class="assess-row">
            <div class="assess"><span class="tag" style="color:var(--accent-green)">FREE</span><span class="abbr">BFI-10</span><span class="lab">Personality</span></div>
            <div class="assess"><span class="tag" style="color:var(--accent-green)">FREE</span><span class="abbr">GAD-7</span><span class="lab">Anxiety</span></div>
            <div class="assess"><span class="tag" style="color:#db2777">PREMIUM</span><span class="abbr">PHQ-9</span><span class="lab">Depression</span></div>
          </div>
        </div>
      </section>

      <section class="card span-3">
        <div class="card-head">
          <div><h2>What you can do next</h2><div class="meta">Useful options between sessions</div></div>
        </div>
        <div class="next-grid">
          <div class="next-card">
            <span class="pill pill-brand">Credits</span>
            <h3>Get more credits</h3>
            <p>Purchase credits to book sessions with your therapist.</p>
            <span class="cta">Browse packages →</span>
          </div>
          <div class="next-card">
            <span class="pill pill-brand">Check-in</span>
            <h3>Take an assessment</h3>
            <p>Check in with how you are feeling today.</p>
            <span class="cta">Start assessment →</span>
          </div>
          <div class="next-card">
            <span class="pill pill-brand">Billing</span>
            <h3>Your Invoices</h3>
            <p>Download and manage your billing history.</p>
            <span class="cta">View invoices →</span>
          </div>
        </div>
      </section>
    </div>
  </main>
</div>
<div class="design-badge">Design B · Visual dashboard · existing theme</div>
</body>
</html>
