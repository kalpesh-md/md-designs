<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MoodScale — Client Dashboard · Design C</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../02-tokens/tokens.css">
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1.4fr) 340px; gap: var(--space-5); align-items: start; }
  .stack { display: flex; flex-direction: column; gap: var(--space-5); }

  .compact-head { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .compact-head h2 { font-size: 14px; font-weight: 700; }
  .pad { padding: 16px; }

  .match-row { display: flex; gap: 12px; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-tint); margin-bottom: 10px; }
  .match-row:last-child { margin-bottom: 0; }
  .match-row .who { flex: 1; min-width: 0; }
  .match-row .name { font-size: 13px; font-weight: 600; }
  .match-row .spec { font-size: 11px; color: var(--ink-tertiary); }
  .match-row .reason { font-size: 11px; color: var(--ink-secondary); font-style: italic; margin-top: 4px; }

  .dates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .date-chip { text-align: center; padding: 8px 4px; border: 1px solid var(--border); border-radius: 8px; }
  .date-chip .d { font-size: 10px; color: var(--ink-tertiary); }
  .date-chip .n { font-size: 18px; font-weight: 700; display: block; }
  .date-chip.on { border-color: var(--brand); background: var(--brand-soft); }
  .times { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .time-chip { padding: 6px 10px; font-size: 11px; font-weight: 600; border: 1px solid var(--border); border-radius: 6px; }

  .assess-list { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
  .assess { text-align: center; padding: 10px 6px; border: 1px solid var(--border); border-radius: 8px; }
  .assess .tag { font-size: 9px; font-weight: 700; letter-spacing: .06em; }
  .assess .abbr { font-size: 16px; font-weight: 700; display: block; }
  .assess .lab { font-size: 10px; color: var(--ink-tertiary); }

  .kv { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .kv .k { font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-tertiary); }
  .kv .v { font-size: 13px; font-weight: 600; }

  .next-item { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--border); }
  .next-item:first-child { border-top: none; padding-top: 0; }
  .next-item .ico { width: 32px; height: 32px; border-radius: 8px; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .next-item h3 { font-size: 13px; font-weight: 600; }
  .next-item p { font-size: 11px; color: var(--ink-secondary); }
  .next-item .cta { font-size: 11px; font-weight: 600; color: var(--brand); }

  .book-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid var(--border); }
  .book-row:first-child { border-top: none; padding-top: 0; }
  .book-row .name { font-size: 13px; font-weight: 600; }
  .book-row .spec { font-size: 11px; color: var(--ink-tertiary); }

  @media (max-width: 1100px) { .layout { grid-template-columns: 1fr; } .assess-list { grid-template-columns: 1fr; } }
</style>
</head>
<body class="palette-c portal-client">
<header class="topbar">
  <div class="topbar-left">
    <img src="assets/moodscale_logo1.png" alt="MoodScale" class="logo-wordmark-lg">
    <span class="topbar-divider"></span>
    <span class="topbar-title">Dashboard</span>
  </div>
  <div class="topbar-right">
    <span class="credit-chip"><img src="assets/icon-192.png" alt="" width="16" height="16"> 3 session credits</span>
    <button class="icon-btn" aria-label="Notifications">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="notif-dot"></span>
    </button>
    <span class="avatar">KS</span>
  </div>
</header>
<div class="shell">
  <aside class="sidebar">
    <nav class="nav">
      <a href="#" class="active"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Dashboard</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span>Sessions</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><span>Assessments</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Credits</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><span>Packages</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 14v7M7 14v7M17 3v4M7 3v4M12 21V3"/></svg><span>Nature Retreats</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span>Messages</span></a>
      <a href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg><span>Live Support</span></a>
    </nav>
    <div class="sidebar-footer">
      <span class="avatar">KS</span>
      <div class="who"><div class="name">Kalpesh S.</div><div class="meta">3 session credits</div></div>
    </div>
  </aside>

  <main class="main">
    <header class="page-header" style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap">
      <div>
        <h1>Welcome back, Kalpesh</h1>
        <p class="sub">What would you like to do today?</p>
      </div>
      <a class="btn btn-primary" href="#">Match Me with a Therapist</a>
    </header>

    <div class="layout">
      <div class="stack">
        <section class="card">
          <div class="compact-head">
            <h2 style="display:flex;align-items:center;gap:8px"><img src="assets/icon-192.png" alt="" width="20" height="20"> Your AI Matches</h2>
            <span class="meta" style="font-size:11px;color:var(--ink-tertiary)">1 remaining this month</span>
          </div>
          <div class="pad">
            <div class="match-row">
              <span class="avatar">DR</span>
              <div class="who">
                <div class="name">Dr. Riya Mehta</div>
                <div class="spec">Anxiety · CBT · ★ 4.9 · Video / Phone</div>
                <div class="reason">Strong match for sleep anxiety and structured CBT work.</div>
              </div>
              <a class="ghost-link" href="#">View →</a>
            </div>
            <div class="match-row">
              <span class="avatar">AK</span>
              <div class="who">
                <div class="name">Aarav Kapoor</div>
                <div class="spec">Couples · Trauma · ★ 4.8 · Video</div>
                <div class="reason">Aligned with a calm, insight-led style.</div>
              </div>
              <a class="ghost-link" href="#">View →</a>
            </div>
            <div class="match-row">
              <span class="avatar">NS</span>
              <div class="who">
                <div class="name">Neha Shah</div>
                <div class="spec">Stress · Mindfulness · ★ 4.7 · Video / Phone</div>
                <div class="reason">Practical between-session tools.</div>
              </div>
              <a class="ghost-link" href="#">View →</a>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="compact-head">
            <h2>Earliest Booking</h2>
            <a class="ghost-link" href="#">View all →</a>
          </div>
          <div class="pad">
            <div class="dates">
              <div class="date-chip on"><span class="d">Wed</span><span class="n">19</span></div>
              <div class="date-chip"><span class="d">Thu</span><span class="n">20</span></div>
              <div class="date-chip"><span class="d">Fri</span><span class="n">21</span></div>
            </div>
            <div class="times">
              <span class="time-chip">10:00 AM</span>
              <span class="time-chip">12:00 PM · 2</span>
              <span class="time-chip">3:00 PM</span>
              <span class="time-chip">6:00 PM</span>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="compact-head">
            <h2>Quick Assessment</h2>
            <a class="ghost-link" href="#">View all →</a>
          </div>
          <div class="pad">
            <div class="assess-list">
              <div class="assess"><span class="tag" style="color:var(--accent-green)">FREE</span><span class="abbr">BFI-10</span><span class="lab">Personality</span></div>
              <div class="assess"><span class="tag" style="color:var(--accent-green)">FREE</span><span class="abbr">GAD-7</span><span class="lab">Anxiety</span></div>
              <div class="assess"><span class="tag" style="color:#db2777">PREMIUM</span><span class="abbr">PHQ-9</span><span class="lab">Depression</span></div>
            </div>
          </div>
        </section>
      </div>

      <div class="stack">
        <section class="card">
          <div class="compact-head">
            <h2>Upcoming Session</h2>
            <span class="pill pill-success">Upcoming</span>
          </div>
          <div class="pad">
            <div class="kv">
              <div><div class="k">Date</div><div class="v">Thu, 20 Aug</div></div>
              <div><div class="k">Time</div><div class="v">10:00 AM</div></div>
              <div><div class="k">Type</div><div class="v">Video</div></div>
              <div><div class="k">Duration</div><div class="v">50 min</div></div>
            </div>
            <a class="btn btn-secondary" href="#" style="width:100%;justify-content:center;margin-top:14px;padding:8px 16px">View details</a>
          </div>
        </section>

        <section class="card">
          <div class="compact-head">
            <h2>Book with a Therapist</h2>
            <a class="ghost-link" href="#">Browse all →</a>
          </div>
          <div class="pad">
            <div class="book-row">
              <span class="avatar">DR</span>
              <div style="flex:1"><div class="name">Dr. Riya Mehta</div><div class="spec">Anxiety · CBT</div></div>
              <span class="pill pill-info">Video</span>
            </div>
            <div class="book-row">
              <span class="avatar">AK</span>
              <div style="flex:1"><div class="name">Aarav Kapoor</div><div class="spec">Couples · Trauma</div></div>
              <span class="pill pill-info">Video</span>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="compact-head"><h2>What you can do next</h2></div>
          <div class="pad">
            <div class="next-item">
              <div class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
              <div><h3>Get more credits</h3><p>Purchase credits to book sessions.</p><span class="cta">Browse packages →</span></div>
            </div>
            <div class="next-item">
              <div class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8z"/><path d="M14 2v6h6"/></svg></div>
              <div><h3>Take an assessment</h3><p>Check in with how you feel today.</p><span class="cta">Start assessment →</span></div>
            </div>
            <div class="next-item">
              <div class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8z"/><path d="M14 2v6h6"/></svg></div>
              <div><h3>Your Invoices</h3><p>Download billing history.</p><span class="cta">View invoices →</span></div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</div>
<div class="design-badge">Design C · Compact dashboard · existing theme</div>
</body>
</html>
